%YAML 1.2
---
{
 "name": "shiki-sass",
 "scope": "source.sass",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "match": "^(\\s*)(/\\*)",
    "push": [
     {
      "meta_scope": "comment.block.sass"
     },
     {
      "match": "(\\*/)|^(?!\\s\\1)",
      "pop": true
     },
     {
      "include": "r_comment_tag"
     },
     {
      "include": "r_comment_param"
     }
    ]
   },
   {
    "match": "^[\\t ]*/?//[\\t ]*[IRS][\\t ]*$",
    "scope": "keyword.other.sass.formatter.action"
   },
   {
    "match": "^[\\t ]*//[\\t ]*(import)[\\t ]*(css-variables)[\\t ]*(from)",
    "push": [
     {
      "meta_scope": "comment.import.css.variables"
     },
     {
      "match": "$\\n?",
      "pop": true,
      "captures": {
       1: "keyword.control",
       2: "variable",
       3: "keyword.control"
      }
     },
     {
      "include": "r_import_quotes"
     }
    ],
    "captures": {
     1: "keyword.control",
     2: "variable",
     3: "keyword.control"
    }
   },
   {
    "include": "r_double_slash"
   },
   {
    "include": "r_double_quoted"
   },
   {
    "include": "r_single_quoted"
   },
   {
    "include": "r_interpolation"
   },
   {
    "include": "r_curly_brackets"
   },
   {
    "include": "r_placeholder_selector"
   },
   {
    "match": "\\$[-0-9A-Z_a-z]+(?=:)",
    "push": [
     {
      "meta_scope": "sass.script.maps"
     },
     {
      "match": "$\\n?|(?=\\)(?:\\s\\)|\\n))",
      "pop": true,
      "scope": "variable.other.name"
     },
     {
      "include": "r_double_slash"
     },
     {
      "include": "r_double_quoted"
     },
     {
      "include": "r_single_quoted"
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_rgb_value"
     },
     {
      "include": "r_numeric"
     },
     {
      "include": "r_unit"
     },
     {
      "include": "r_flag"
     },
     {
      "include": "r_comma"
     },
     {
      "include": "r_function"
     },
     {
      "include": "r_function_content"
     },
     {
      "include": "r_operator"
     },
     {
      "include": "r_reserved_words"
     },
     {
      "include": "r_parent_selector"
     },
     {
      "include": "r_property_value"
     },
     {
      "include": "r_semicolon"
     },
     {
      "include": "r_dotdotdot"
     }
    ],
    "scope": "variable.other.name"
   },
   {
    "include": "r_variable_root"
   },
   {
    "include": "r_numeric"
   },
   {
    "include": "r_unit"
   },
   {
    "include": "r_flag"
   },
   {
    "include": "r_comma"
   },
   {
    "include": "r_semicolon"
   },
   {
    "include": "r_dotdotdot"
   },
   {
    "match": "@include|\\+(?![\\W\\d])",
    "push": [
     {
      "meta_scope": "support.function.name.sass.library"
     },
     {
      "match": "(?=[\\n(])",
      "pop": true,
      "scope": "keyword.control.at-rule.css.sass"
     }
    ],
    "scope": "keyword.control.at-rule.css.sass"
   },
   {
    "match": "^(@use)",
    "push": [
     {
      "meta_scope": "sass.use"
     },
     {
      "match": "(?=\\n)",
      "pop": true,
      "scope": "keyword.control.at-rule.css.sass.use"
     },
     {
      "match": "as|with",
      "scope": "support.type.css.sass"
     },
     {
      "include": "r_numeric"
     },
     {
      "include": "r_unit"
     },
     {
      "include": "r_variable_root"
     },
     {
      "include": "r_rgb_value"
     },
     {
      "include": "r_comma"
     },
     {
      "include": "r_parenthesis_open"
     },
     {
      "include": "r_parenthesis_close"
     },
     {
      "include": "r_colon"
     },
     {
      "include": "r_import_quotes"
     }
    ],
    "scope": "keyword.control.at-rule.css.sass.use"
   },
   {
    "match": "^@import(.*?)( as.*)?$",
    "push": [
     {
      "meta_scope": "keyword.control.at-rule.use"
     },
     {
      "match": "(?=\\n)",
      "pop": true,
      "captures": {
       1: "constant.character.css.sass",
       2: "invalid"
      }
     }
    ],
    "captures": {
     1: "constant.character.css.sass",
     2: "invalid"
    }
   },
   {
    "match": "@mixin|^[\\t ]*=|@function",
    "push": [
     {
      "meta_scope": "support.function.name.sass"
     },
     {
      "match": "$\\n?|(?=\\()",
      "pop": true,
      "scope": "keyword.control.at-rule.css.sass"
     },
     {
      "match": "[-\\w]+",
      "scope": "entity.name.function"
     }
    ],
    "scope": "keyword.control.at-rule.css.sass"
   },
   {
    "match": "@",
    "push": [
     {
      "meta_scope": "keyword.control.at-rule.css.sass"
     },
     {
      "match": "$\\n?|\\s(?!(all|braille|embossed|handheld|print|projection|screen|speech|tty|tv|if|only|not)([,\\s]))",
      "pop": true
     }
    ]
   },
   {
    "match": "(?<![-(])\\b(a|abbr|acronym|address|applet|area|article|aside|audio|b|base|big|blockquote|body|br|button|canvas|caption|cite|code|col|colgroup|datalist|dd|del|details|dfn|dialog|div|dl|dt|em|embed|eventsource|fieldset|figure|figcaption|footer|form|frame|frameset|(h[1-6])|head|header|hgroup|hr|html|i|iframe|img|input|ins|kbd|label|legend|li|link|map|mark|menu|meta|meter|nav|noframes|noscript|object|ol|optgroup|option|output|p|param|picture|pre|progress|q|samp|script|section|select|small|source|span|strike|strong|style|sub|summary|sup|table|tbody|td|textarea|tfoot|th|thead|time|title|tr|tt|ul|var|video|main|svg|rect|ruby|center|circle|ellipse|line|polyline|polygon|path|text|u|slot)\\b(?![-)]|:\\s)|&",
    "push": [
     {
      "meta_scope": "entity.name.tag.css.sass.symbol"
     },
     {
      "match": "$\\n?|(?=[-#(),.>\\[_\\s])",
      "pop": true
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_pseudo_class"
     }
    ]
   },
   {
    "match": "#",
    "push": [
     {
      "meta_scope": "entity.other.attribute-name.id.css.sass"
     },
     {
      "match": "$\\n?|(?=[(),.>\\[\\s])",
      "pop": true
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_pseudo_class"
     }
    ]
   },
   {
    "match": "\\.|(?<=&)([-_])",
    "push": [
     {
      "meta_scope": "entity.other.attribute-name.class.css.sass"
     },
     {
      "match": "$\\n?|(?=[(),>\\[\\s])",
      "pop": true
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_pseudo_class"
     }
    ]
   },
   {
    "match": "\\[",
    "push": [
     {
      "meta_scope": "entity.other.attribute-selector.sass"
     },
     {
      "match": "]",
      "pop": true
     },
     {
      "include": "r_double_quoted"
     },
     {
      "include": "r_single_quoted"
     },
     {
      "match": "[$*^~]",
      "scope": "keyword.other.regex.sass"
     }
    ]
   },
   {
    "match": "^((?<=[])]|not\\(|[*>]|>\\s)|\\n*):[-:a-z]+|(:[-:])[-:a-z]+",
    "scope": "entity.other.attribute-name.pseudo-class.css.sass"
   },
   {
    "include": "r_module"
   },
   {
    "match": "[-\\w]*\\(",
    "scope": "entity.name.function"
   },
   {
    "match": "\\)",
    "scope": "entity.name.function.close"
   },
   {
    "match": ":",
    "push": [
     {
      "meta_scope": "meta.property-list.css.sass.prop"
     },
     {
      "match": "$\\n?|(?=\\s\\(|and\\(|\\),)",
      "pop": true
     },
     {
      "match": "(?<=:)[-a-z]+\\s",
      "scope": "support.type.property-name.css.sass.prop.name"
     },
     {
      "include": "r_double_slash"
     },
     {
      "include": "r_double_quoted"
     },
     {
      "include": "r_single_quoted"
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_curly_brackets"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_rgb_value"
     },
     {
      "include": "r_numeric"
     },
     {
      "include": "r_unit"
     },
     {
      "include": "r_module"
     },
     {
      "match": "--.+?(?=\\))",
      "scope": "variable.css"
     },
     {
      "match": "[-\\w]*\\(",
      "scope": "entity.name.function"
     },
     {
      "match": "\\)",
      "scope": "entity.name.function.close"
     },
     {
      "include": "r_flag"
     },
     {
      "include": "r_comma"
     },
     {
      "include": "r_semicolon"
     },
     {
      "include": "r_function"
     },
     {
      "include": "r_function_content"
     },
     {
      "include": "r_operator"
     },
     {
      "include": "r_parent_selector"
     },
     {
      "include": "r_property_value"
     }
    ]
   },
   {
    "include": "r_rgb_value"
   },
   {
    "include": "r_function"
   },
   {
    "include": "r_function_content"
   },
   {
    "match": "(?<=})(?![\\n()]|[-0-9A-Z_a-z]+:)",
    "push": [
     {
      "meta_scope": "entity.name.tag.css.sass"
     },
     {
      "match": "\\s|(?=[\\n),.\\[])",
      "pop": true
     },
     {
      "include": "r_interpolation"
     },
     {
      "include": "r_pseudo_class"
     }
    ]
   },
   {
    "include": "r_operator"
   },
   {
    "match": "[-a-z]+((?=:|#\\{))",
    "scope": "support.type.property-name.css.sass.prop.name"
   },
   {
    "include": "r_reserved_words"
   },
   {
    "include": "r_property_value"
   }
  ],
  "r_colon": [
   {
    "match": ":",
    "scope": "meta.property-list.css.sass.colon"
   }
  ],
  "r_comma": [
   {
    "match": "\\band\\b|\\bor\\b|,",
    "scope": "comment.punctuation.comma.sass"
   }
  ],
  "r_comment_param": [
   {
    "match": "@(\\w+)",
    "scope": "storage.type.class.jsdoc"
   }
  ],
  "r_comment_tag": [
   {
    "match": "(?<=\\{\\{)",
    "push": [
     {
      "meta_scope": "comment.tag.sass"
     },
     {
      "match": "(?=}})",
      "pop": true
     }
    ]
   }
  ],
  "r_curly_brackets": [
   {
    "match": "[{}]",
    "scope": "invalid"
   }
  ],
  "r_dotdotdot": [
   {
    "match": "\\.\\.\\.",
    "scope": "variable.other"
   }
  ],
  "r_double_quoted": [
   {
    "match": "\"",
    "push": [
     {
      "meta_scope": "string.quoted.double.css.sass"
     },
     {
      "match": "\"",
      "pop": true
     },
     {
      "include": "r_quoted_interpolation"
     }
    ]
   }
  ],
  "r_double_slash": [
   {
    "match": "//",
    "push": [
     {
      "meta_scope": "comment.line.sass"
     },
     {
      "match": "$\\n?",
      "pop": true
     },
     {
      "include": "r_comment_tag"
     }
    ]
   }
  ],
  "r_flag": [
   {
    "match": "!(important|default|optional|global)",
    "scope": "keyword.other.important.css.sass"
   }
  ],
  "r_function": [
   {
    "match": "(?<=[(,:|\\s])(?!url|format|attr)[-0-9A-Z_a-z][-\\w]*(?=\\()",
    "scope": "support.function.name.sass"
   }
  ],
  "r_function_content": [
   {
    "match": "(?<=url\\(|format\\(|attr\\()",
    "push": [
     {
      "meta_scope": "string.quoted.double.css.sass"
     },
     {
      "match": ".(?=\\))",
      "pop": true
     }
    ]
   }
  ],
  "r_import_quotes": [
   {
    "match": "[\"']?\\.{0,2}[/\\w]+[\"']?",
    "scope": "constant.character.css.sass"
   }
  ],
  "r_interpolation": [
   {
    "match": "#\\{",
    "push": [
     {
      "meta_scope": "support.function.interpolation.sass"
     },
     {
      "match": "}",
      "pop": true
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_numeric"
     },
     {
      "include": "r_operator"
     },
     {
      "include": "r_unit"
     },
     {
      "include": "r_comma"
     },
     {
      "include": "r_double_quoted"
     },
     {
      "include": "r_single_quoted"
     }
    ]
   }
  ],
  "r_module": [
   {
    "match": "([-\\w]+?)(\\.)",
    "scope": "constant.character.module",
    "captures": {
     1: "constant.character.module.name",
     2: "constant.numeric.module.dot"
    }
   }
  ],
  "r_numeric": [
   {
    "match": "([-.])?[0-9]+(\\.[0-9]+)?",
    "scope": "constant.numeric.css.sass"
   }
  ],
  "r_operator": [
   {
    "match": "\\+|\\s-\\s|\\s-(?=\\$)|(?<=\\()-(?=\\$)|\\s-(?=\\()|[!%*/<=>~]",
    "scope": "keyword.operator.sass"
   }
  ],
  "r_parent_selector": [
   {
    "match": "&",
    "scope": "entity.name.tag.css.sass"
   }
  ],
  "r_parenthesis_close": [
   {
    "match": "\\)",
    "scope": "entity.name.function.parenthesis.close"
   }
  ],
  "r_parenthesis_open": [
   {
    "match": "\\(",
    "scope": "entity.name.function.parenthesis.open"
   }
  ],
  "r_placeholder_selector": [
   {
    "match": "(?<!\\d)%(?!\\d)",
    "push": [
     {
      "meta_scope": "entity.other.inherited-class.placeholder-selector.css.sass"
     },
     {
      "match": "$\\n?|\\s",
      "pop": true
     }
    ]
   }
  ],
  "r_property_value": [
   {
    "match": "[-0-9A-Z_a-z]+",
    "scope": "meta.property-value.css.sass support.constant.property-value.css.sass"
   }
  ],
  "r_pseudo_class": [
   {
    "match": ":[-:a-z]+",
    "scope": "entity.other.attribute-name.pseudo-class.css.sass"
   }
  ],
  "r_quoted_interpolation": [
   {
    "match": "#\\{",
    "push": [
     {
      "meta_scope": "support.function.interpolation.sass"
     },
     {
      "match": "}",
      "pop": true
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_numeric"
     },
     {
      "include": "r_operator"
     },
     {
      "include": "r_unit"
     },
     {
      "include": "r_comma"
     }
    ]
   }
  ],
  "r_reserved_words": [
   {
    "match": "\\b(false|from|in|not|null|through|to|true)\\b",
    "scope": "support.type.property-name.css.sass"
   }
  ],
  "r_rgb_value": [
   {
    "match": "(#)(\\h{3,4}|\\h{6}|\\h{8})\\b",
    "scope": "constant.language.color.rgb-value.css.sass"
   }
  ],
  "r_semicolon": [
   {
    "match": ";",
    "scope": "invalid"
   }
  ],
  "r_single_quoted": [
   {
    "match": "'",
    "push": [
     {
      "meta_scope": "string.quoted.single.css.sass"
     },
     {
      "match": "'",
      "pop": true
     },
     {
      "include": "r_quoted_interpolation"
     }
    ]
   }
  ],
  "r_unit": [
   {
    "match": "(?<=[}\\d])(ch|cm|deg|dpcm|dpi|dppx|em|ex|grad|Hz|in|kHz|mm|ms|pc|pt|px|rad|rem|s|turn|vh|vmax|vmin|vw|fr|%)",
    "scope": "keyword.control.unit.css.sass"
   }
  ],
  "r_variable": [
   {
    "match": "\\$[-0-9A-Z_a-z]+",
    "scope": "variable.other.value"
   }
  ],
  "r_variable_root": [
   {
    "match": "\\$[-0-9A-Z_a-z]+",
    "scope": "variable.other.root"
   }
  ]
 }
}
