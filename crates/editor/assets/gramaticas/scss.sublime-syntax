     },
     {
      "include": "r_comment_block"
     },
     {
      "include": "r_comment_line"
     },
     {
      "match": "\\b(only)\\b",
      "scope": "keyword.control.operator.css.scss"
     },
     {
      "match": "\\(",
      "push": [
       {
        "meta_scope": "meta.property-list.media-query.scss"
       },
       {
        "match": "\\)",
        "pop": true,
        "scope": "punctuation.definition.media-query.end.bracket.round.scss"
       },
       {
        "match": "(?<![-a-z])(?=[-a-z])",
        "push": [
         {
          "meta_scope": "meta.property-name.media-query.scss"
         },
         {
          "match": "$|(?![-a-z])",
          "pop": true
         },
         {
          "include": "scope:source.css#r_media_features"
         },
         {
          "include": "scope:source.css#r_property_names"
         }
        ]
       },
       {
        "match": "(:)\\s*(?!(\\s*\\{))",
        "push": [
         {
          "meta_content_scope": "meta.property-value.media-query.scss"
         },
         {
          "match": "\\s*(;|(?=[)}]))",
          "pop": true,
          "captures": {
           1: "punctuation.terminator.rule.scss"
          }
         },
         {
          "include": "r_general"
         },
         {
          "include": "r_property_values"
         }
        ],
        "captures": {
         1: "punctuation.separator.key-value.scss"
        }
       }
      ],
      "scope": "punctuation.definition.media-query.begin.bracket.round.scss"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_conditional_operators"
     },
     {
      "include": "scope:source.css#r_media_types"
