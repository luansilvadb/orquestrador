%YAML 1.2
---
{
 "name": "shiki-scss",
 "scope": "source.css.scss",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "include": "r_variable_setting"
   },
   {
    "include": "r_at_rule_forward"
   },
   {
    "include": "r_at_rule_use"
   },
   {
    "include": "r_at_rule_include"
   },
   {
    "include": "r_at_rule_import"
   },
   {
    "include": "r_general"
   },
   {
    "include": "r_flow_control"
   },
   {
    "include": "r_rules"
   },
   {
    "include": "r_property_list"
   },
   {
    "include": "r_at_rule_mixin"
   },
   {
    "include": "r_at_rule_media"
   },
   {
    "include": "r_at_rule_function"
   },
   {
    "include": "r_at_rule_charset"
   },
   {
    "include": "r_at_rule_option"
   },
   {
    "include": "r_at_rule_namespace"
   },
   {
    "include": "r_at_rule_fontface"
   },
   {
    "include": "r_at_rule_page"
   },
   {
    "include": "r_at_rule_keyframes"
   },
   {
    "include": "r_at_rule_at_root"
   },
   {
    "include": "r_at_rule_supports"
   },
   {
    "match": ";",
    "scope": "punctuation.terminator.rule.css"
   }
  ],
  "r_at_rule_at_root": [
   {
    "match": "\\s*((@)(at-root))(\\s+|$)",
    "push": [
     {
      "meta_scope": "meta.at-rule.at-root.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true
     },
     {
      "include": "r_function_attributes"
     },
     {
      "include": "r_functions"
     },
     {
      "include": "r_selectors"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.at-root.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_charset": [
   {
    "match": "\\s*((@)charset)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.charset.scss"
     },
     {
      "match": "\\s*((?=;|$))",
      "pop": true,
      "captures": {
       1: "keyword.control.at-rule.charset.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_string_single"
     },
     {
      "include": "r_string_double"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.charset.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_content": [
   {
    "match": "\\s*((@)content)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.content.scss"
     },
     {
      "match": "\\s*((?=;))",
      "pop": true,
      "captures": {
       1: "keyword.control.content.scss"
      }
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_selectors"
     },
     {
      "include": "r_property_values"
     }
    ],
    "captures": {
     1: "keyword.control.content.scss"
    }
   }
  ],
  "r_at_rule_each": [
   {
    "match": "\\s*((@)each)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.each.scss"
     },
     {
      "match": "\\s*((?=}))",
      "pop": true,
      "captures": {
       1: "keyword.control.each.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "match": "\\b(in|,)\\b",
      "scope": "keyword.control.operator"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_property_values"
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.control.each.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_else": [
   {
    "match": "\\s*((@)else(\\s*(if)?))\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.else.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true,
      "captures": {
       1: "keyword.control.else.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "include": "r_conditional_operators"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_property_values"
     }
    ],
    "captures": {
     1: "keyword.control.else.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_extend": [
   {
    "match": "\\s*((@)extend)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.extend.scss"
     },
     {
      "match": "\\s*(?=;)",
      "pop": true,
      "captures": {
       1: "keyword.control.at-rule.extend.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_selectors"
     },
     {
      "include": "r_property_values"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.extend.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_fontface": [
   {
    "match": "^\\s*((@)font-face)\\b",
    "push": [
     {
      "meta_scope": "meta.at-rule.fontface.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true
     },
     {
      "include": "r_function_attributes"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.fontface.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_for": [
   {
    "match": "\\s*((@)for)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.for.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true,
      "captures": {
       1: "keyword.control.for.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "match": "(==|!=|<=|>=|[<>]|from|to|through)",
      "scope": "keyword.control.operator"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_property_values"
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.control.for.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_forward": [
   {
    "match": "\\s*((@)forward)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.forward.scss"
     },
     {
      "match": "\\s*(?=;)",
      "pop": true,
      "captures": {
       1: "keyword.control.at-rule.forward.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "match": "\\b(as|hide|show)\\b",
      "scope": "keyword.control.operator"
     },
     {
      "match": "\\b([-\\w]+)(\\*)",
      "captures": {
       1: "entity.other.attribute-name.module.scss",
       2: "punctuation.definition.wildcard.scss"
      }
     },
     {
      "match": "\\b[-\\w]+\\b",
      "scope": "entity.name.function.scss"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_string_single"
     },
     {
      "include": "r_string_double"
     },
     {
      "include": "r_comment_line"
     },
     {
      "include": "r_comment_block"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.forward.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_function": [
   {
    "match": "\\s*((@)function)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.function.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true,
      "captures": {
       1: "keyword.control.at-rule.function.scss",
       2: "punctuation.definition.keyword.scss",
       3: "entity.name.function.scss"
      }
     },
     {
      "include": "r_function_attributes"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.function.scss",
     2: "punctuation.definition.keyword.scss",
     3: "entity.name.function.scss"
    }
   },
   {
    "match": "\\s*((@)function)\\b\\s*",
    "scope": "meta.at-rule.function.scss",
    "captures": {
     1: "keyword.control.at-rule.function.scss",
     2: "punctuation.definition.keyword.scss",
     3: "entity.name.function.scss"
    }
   }
  ],
  "r_at_rule_if": [
   {
    "match": "\\s*((@)if)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.if.scss"
     },
     {
      "match": "\\s*(?=\\{)",
      "pop": true,
      "captures": {
       1: "keyword.control.if.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "include": "r_conditional_operators"
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_property_values"
     }
    ],
    "captures": {
     1: "keyword.control.if.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_import": [
   {
    "match": "\\s*((@)import)\\b\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.import.scss"
     },
     {
      "match": "\\s*((?=;)|(?=}))",
      "pop": true,
      "captures": {
       1: "keyword.control.at-rule.import.scss",
       2: "punctuation.definition.keyword.scss"
      }
     },
     {
      "include": "r_variable"
     },
     {
      "include": "r_string_single"
     },
     {
      "include": "r_string_double"
     },
     {
      "include": "r_functions"
     },
     {
      "include": "r_comment_line"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.import.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_include": [
   {
    "match": "(?<=@include)\\s+(?:([-\\w]+)\\s*(\\.))?([-\\w]+)\\s*(\\()",
    "push": [
     {
      "meta_scope": "meta.at-rule.include.scss"
     },
     {
      "match": "\\)",
      "pop": true,
      "scope": "punctuation.definition.parameters.end.bracket.round.scss"
     },
     {
      "include": "r_function_attributes"
     }
    ],
    "captures": {
     1: "variable.scss",
     2: "punctuation.access.module.scss",
     3: "entity.name.function.scss",
     4: "punctuation.definition.parameters.begin.bracket.round.scss"
    }
   },
   {
    "match": "(?<=@include)\\s+(?:([-\\w]+)\\s*(\\.))?([-\\w]+)",
    "scope": "meta.at-rule.include.scss",
    "captures": {
     1: "variable.scss",
     2: "punctuation.access.module.scss",
     3: "entity.name.function.scss"
    }
   },
   {
    "match": "((@)include)\\b",
    "scope": "meta.at-rule.include.scss",
    "captures": {
     1: "keyword.control.at-rule.include.scss",
     2: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_keyframes": [
   {
    "match": "(?<=^|\\s)(@)(?:-(?:webkit|moz)-)?keyframes\\b",
    "push": [
     {
      "meta_scope": "meta.at-rule.keyframes.scss"
     },
     {
      "match": "(?<=})",
      "pop": true
     },
     {
      "match": "(?<=@keyframes)\\s+((?:[A-Z_a-z][-\\w]|-[A-Z_a-z])[-\\w]*)",
      "captures": {
       1: "entity.name.function.scss"
      }
     },
     {
      "match": "(?<=@keyframes)\\s+(\")",
      "push": [
       {
        "meta_scope": "string.quoted.double.scss"
       },
       {
        "meta_content_scope": "entity.name.function.scss"
       },
       {
        "match": "\"",
        "pop": true,
        "scope": "punctuation.definition.string.end.scss"
       },
       {
        "match": "\\\\(\\h{1,6}|.)",
        "scope": "constant.character.escape.scss"
       },
       {
        "include": "r_interpolation"
       }
      ],
      "captures": {
       1: "punctuation.definition.string.begin.scss"
      }
     },
     {
      "match": "(?<=@keyframes)\\s+(')",
      "push": [
       {
        "meta_scope": "string.quoted.single.scss"
       },
       {
        "meta_content_scope": "entity.name.function.scss"
       },
       {
        "match": "'",
        "pop": true,
        "scope": "punctuation.definition.string.end.scss"
       },
       {
        "match": "\\\\(\\h{1,6}|.)",
        "scope": "constant.character.escape.scss"
       },
       {
        "include": "r_interpolation"
       }
      ],
      "captures": {
       1: "punctuation.definition.string.begin.scss"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.keyframes.end.scss"
       },
       {
        "match": "\\b(?:(?:100|[1-9]\\d|\\d)%|from|to)(?=\\s*\\{)",
        "scope": "entity.other.attribute-name.scss"
       },
       {
        "include": "r_flow_control"
       },
       {
        "include": "r_interpolation"
       },
       {
        "include": "r_property_list"
       },
       {
        "include": "r_rules"
       }
      ],
      "scope": "punctuation.section.keyframes.begin.scss"
     }
    ],
    "scope": "keyword.control.at-rule.keyframes.scss",
    "captures": {
     1: "punctuation.definition.keyword.scss"
    }
   }
  ],
  "r_at_rule_media": [
   {
    "match": "^\\s*((@)media)\\b",
    "push": [
