%YAML 1.2
---
{
 "name": "shiki-haml",
 "scope": "text.haml",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "match": "^(\\s*)==",
    "push": [
     {
      "meta_content_scope": "string.quoted.double.ruby"
     },
     {
      "match": "$\\n*",
      "pop": true
     },
     {
      "include": "r_interpolated_ruby"
     }
    ]
   },
   {
    "match": "^(\\s*):ruby",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.filter.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.ruby"
     }
    ]
   },
   {
    "match": "^(!!!)($|\\s.*)",
    "scope": "meta.prolog.haml",
    "captures": {
     1: "punctuation.definition.prolog.haml"
    }
   },
   {
    "match": "^(\\s*):javascript",
    "push": [
     {
      "meta_scope": "js.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.js"
     }
    ]
   },
   {
    "match": "^(\\s*)%script",
    "push": [
     {
      "meta_scope": "js.inline.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.js"
     }
    ]
   },
   {
    "match": "^(\\s*):ruby$",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.filter.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.ruby"
     }
    ]
   },
   {
    "match": "^(\\s*)(/\\[[^]].*?$\\n?)",
    "scope": "comment.line.slash.haml",
    "captures": {
     1: "punctuation.section.comment.haml"
    }
   },
   {
    "match": "^(\\s*)(-#|/|-\\s*/\\*+)",
    "push": [
     {
      "meta_scope": "comment.block.haml"
     },
     {
      "match": "^(?!\\1\\s+|\\n)",
      "pop": true
     },
     {
      "include": "scope:text.haml"
     }
    ],
    "captures": {
     2: "punctuation.section.comment.haml"
    }
   },
   {
    "match": "^\\s*(?:((%)([-:\\w]+))|(?=[#.]))",
    "push": [
     {
      "match": "$|(?![#(.\\[{]|&amp;|[-=~]|!=|&=|/)",
      "pop": true,
      "captures": {
       1: "meta.tag.haml",
       2: "punctuation.definition.tag.haml",
       3: "entity.name.tag.haml"
      }
     },
     {
      "match": "==",
      "push": [
       {
        "meta_content_scope": "string.quoted.double.ruby"
       },
       {
        "match": "$\\n?",
        "pop": true
       },
       {
        "include": "r_interpolated_ruby"
       }
      ]
     },
     {
      "match": "(\\.[-:\\w]+)",
      "scope": "meta.selector.css",
      "captures": {
       1: "entity.other.attribute-name.class"
      }
     },
     {
      "match": "(#[-\\w]+)",
      "scope": "meta.selector.css",
      "captures": {
       1: "entity.other.attribute-name.id"
      }
     },
     {
      "match": "(?<!#)\\{(?=.*(,|(do)|[{|}]|(#.*)|\\R)\\s*)",
      "push": [
       {
        "meta_scope": "meta.section.attributes.haml"
       },
       {
        "match": "\\s*}(?!\\s*,)(?!\\s*\\|)(?!#\\{.*})",
        "pop": true
       },
       {
        "include": "scope:source.ruby"
       },
       {
        "include": "r_continuation"
       },
       {
        "include": "r_rubyline"
       }
      ]
     },
     {
      "match": "\\(",
      "push": [
       {
        "meta_scope": "meta.section.attributes.plain.haml"
       },
       {
        "match": "\\)",
        "pop": true
       },
       {
        "match": "([-\\w]+)",
        "scope": "constant.other.symbol.ruby"
       },
       {
        "match": "=",
        "scope": "punctuation"
       },
       {
        "include": "r_variables"
       },
       {
        "match": "\"",
        "push": [
         {
          "meta_scope": "string.quoted.double.ruby"
         },
         {
          "match": "\"",
          "pop": true
         },
         {
          "match": "\\\\(x\\h{2}|[012][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.)",
          "scope": "constant.character.escape.ruby"
         },
         {
          "include": "r_interpolated_ruby"
         }
        ]
       },
       {
        "include": "r_interpolated_ruby"
       }
      ]
     },
     {
      "match": "\\[(?=.+([],\\[|]|(#.*))\\s*)",
      "push": [
       {
        "meta_scope": "meta.section.object.haml"
       },
       {
        "match": "\\s*](?!.*(?!#\\[)])",
        "pop": true
       },
       {
        "include": "scope:source.ruby"
       },
       {
        "include": "r_continuation"
       },
       {
        "include": "r_rubyline"
       }
      ]
     },
     {
      "include": "r_interpolated_ruby_line"
     },
     {
      "include": "r_rubyline"
     },
     {
      "match": "/",
      "scope": "punctuation.terminator.tag.haml"
     }
    ],
    "captures": {
     1: "meta.tag.haml",
     2: "punctuation.definition.tag.haml",
     3: "entity.name.tag.haml"
    }
   },
   {
    "match": "^(\\s*):(ruby|opal)$",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.filter.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.ruby"
     }
    ]
   },
   {
    "match": "^(\\s*):ruby$",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.filter.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.ruby"
     }
    ]
   },
   {
    "match": "^(\\s*):(s(?:tyle|ass))$",
    "push": [
     {
      "meta_scope": "source.sass.embedded.filter.haml"
     },
     {
      "match": "^(?=\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.sass"
     }
    ]
   },
   {
    "match": "^(\\s*):coffee(script)?",
    "push": [
     {
      "meta_scope": "source.coffee.embedded.filter.haml"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.coffee"
     }
    ]
   },
   {
    "match": "^(\\s*):plain$",
    "push": [
     {
      "meta_scope": "text.plain.embedded.filter.haml"
     },
     {
      "match": "^(?=\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:text.plain"
     }
    ]
   },
   {
    "match": "^(\\s*)(:ruby)",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.filter.haml"
     },
     {
      "match": "(?m:(?<=\\n)(?!\\1\\s+|$\\n*))",
      "pop": true
     },
     {
      "include": "scope:source.ruby"
     }
    ],
    "captures": {
     2: "keyword.control.filter.haml"
    }
   },
   {
    "match": "^(\\s*)(:sass)",
    "push": [
     {
      "meta_scope": "source.embedded.filter.sass"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.sass"
     }
    ],
    "captures": {
     2: "keyword.control.filter.haml"
    }
   },
   {
    "match": "^(\\s*):(s(?:tyles|ass))$",
    "push": [
     {
      "meta_scope": "source.sass.embedded.filter.haml"
     },
     {
      "match": "^(?=\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:source.sass"
     }
    ]
   },
   {
    "match": "^(\\s*):plain$",
    "push": [
     {
      "meta_scope": "text.plain.embedded.filter.haml"
     },
     {
      "match": "^(?=\\1\\s+|$\\n*)",
      "pop": true
     },
     {
      "include": "scope:text.plain"
     }
    ]
   },
   {
    "match": "^\\s*(\\.)",
    "captures": {
     1: "meta.escape.haml"
    }
   },
   {
    "match": "^\\s*(?=[-=~]|!=|&=)",
    "push": [
     {
      "match": "$",
      "pop": true
     },
     {
      "include": "r_interpolated_ruby_line"
     },
     {
      "include": "r_rubyline"
     }
    ]
   },
   {
    "match": "^(\\s*)(:php)",
    "push": [
     {
      "meta_scope": "meta.embedded.php"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true,
      "captures": {
       2: "entity.name.tag.haml"
      }
     },
     {
      "include": "scope:text.html.php#r_language"
     }
    ],
    "captures": {
     2: "entity.name.tag.haml"
    }
   },
   {
    "match": "^(\\s*)(:markdown)",
    "push": [
     {
      "meta_scope": "meta.embedded.markdown"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true,
      "captures": {
       2: "entity.name.tag.haml"
      }
     },
     {
      "include": "scope:text.html.markdown"
     }
    ],
    "captures": {
     2: "entity.name.tag.haml"
    }
   },
   {
    "match": "^(\\s*)(:(css|styles?))$",
    "push": [
     {
      "meta_scope": "meta.embedded.css"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true,
      "captures": {
       2: "entity.name.tag.haml"
      }
     },
     {
      "include": "scope:source.css"
     }
    ],
    "captures": {
     2: "entity.name.tag.haml"
    }
   },
   {
    "match": "^(\\s*)(:sass)$",
    "push": [
     {
      "meta_scope": "meta.embedded.sass"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true,
      "captures": {
       2: "entity.name.tag.haml"
      }
     },
     {
      "include": "scope:source.sass"
     }
    ],
    "captures": {
     2: "entity.name.tag.haml"
    }
   },
   {
    "match": "^(\\s*)(:scss)$",
    "push": [
     {
      "meta_scope": "meta.embedded.scss"
     },
     {
      "match": "^(?!\\1\\s+|$\\n*)",
      "pop": true,
      "captures": {
       2: "entity.name.tag.haml"
      }
     },
     {
      "include": "scope:source.scss"
     }
    ],
    "captures": {
     2: "entity.name.tag.haml"
    }
   }
  ],
  "r_continuation": [
   {
    "match": "(\\|)\\s*\\n",
    "captures": {
     1: "punctuation.separator.continuation.haml"
    }
   }
  ],
  "r_interpolated_ruby": [
   {
    "match": "#\\{(})",
    "scope": "source.ruby.embedded.source punctuation.section.embedded.ruby",
    "captures": {
     1: "source.ruby.embedded.source.empty"
    }
   },
   {
    "match": "#\\{",
    "push": [
     {
      "meta_scope": "source.ruby.embedded.source"
     },
     {
      "match": "(})",
      "pop": true,
      "scope": "punctuation.section.embedded.ruby"
     },
     {
      "include": "r_nest_curly_and_self"
     },
     {
      "include": "scope:source.ruby"
     }
    ],
    "scope": "punctuation.section.embedded.ruby"
   },
   {
    "include": "r_variables"
   }
  ],
  "r_interpolated_ruby_line": [
   {
    "match": "!?==",
    "push": [
     {
      "meta_scope": "meta.line.ruby.interpolated.haml"
     },
     {
      "meta_content_scope": "string.source.ruby.embedded.haml"
     },
     {
      "match": "$",
      "pop": true
     },
     {
      "include": "r_interpolated_ruby"
     },
     {
      "include": "scope:source.ruby#r_escaped_char"
     }
    ]
   }
  ],
  "r_nest_curly_and_self": [
   {
    "match": "\\{",
    "push": [
     {
      "match": "}",
      "pop": true,
      "scope": "punctuation.section.scope.ruby"
     },
     {
      "include": "r_nest_curly_and_self"
     },
     {
      "include": "scope:source.ruby"
     }
    ],
    "scope": "punctuation.section.scope.ruby"
   }
  ],
  "r_rubyline": [
   {
    "match": "(&amp|!)?([-=~])",
    "push": [
     {
      "meta_scope": "meta.line.ruby.haml"
     },
     {
      "meta_content_scope": "source.ruby.embedded.haml"
     },
     {
      "match": "((do|\\{)( \\|[*.]+\\|)?)$|$|^(?!.*\\|\\s*)$\\n?",
      "pop": true,
      "captures": {
       1: "source.ruby.embedded.html",
       2: "keyword.control.ruby.start-block"
      }
     },
     {
      "match": "\\s+((elseif|foreach|switch|declare|default|use))(?=[(\\s])",
      "captures": {
       1: "keyword.control.php"
      }
     },
     {
      "match": "\\s+((?:requir|includ)e_once)(?=[(\\s])",
      "captures": {
       1: "keyword.control.import.include.php"
      }
     },
     {
      "match": "\\s+(catch|try|throw|exception|finally|die)(?=[(\\s]|\\n*)",
      "scope": "keyword.control.exception.php"
     },
     {
      "match": "\\s+(function\\s*)((?=\\())",
      "captures": {
       1: "storage.type.function.php"
      }
     },
     {
      "match": "\\s+(use\\s*)((?=\\())",
      "captures": {
       1: "keyword.control.php"
      }
     },
     {
      "match": "([,<|]|do|\\{)\\s*(#.*)?$\\n*",
      "scope": "source.ruby"
     },
     {
      "match": "#.*$",
      "scope": "comment.line.number-sign.ruby"
     },
     {
      "include": "scope:source.ruby"
     },
     {
      "include": "r_continuation"
     }
    ]
   }
  ],
  "r_variables": [
   {
    "match": "(#@)[A-Z_a-z]\\w*",
    "scope": "variable.other.readwrite.instance.ruby",
    "captures": {
     1: "punctuation.definition.variable.ruby"
    }
   },
   {
    "match": "(#@@)[A-Z_a-z]\\w*",
    "scope": "variable.other.readwrite.class.ruby",
    "captures": {
     1: "punctuation.definition.variable.ruby"
    }
   },
   {
    "match": "(#\\$)[A-Z_a-z]\\w*",
    "scope": "variable.other.readwrite.global.ruby",
    "captures": {
     1: "punctuation.definition.variable.ruby"
    }
   }
  ]
 }
}
