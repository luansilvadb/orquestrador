%YAML 1.2
---
{
 "name": "shiki-python",
 "scope": "source.python",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "include": "r_statement"
   },
   {
    "include": "r_expression"
   }
  ],
  "r_annotated_parameter": [
   {
    "match": "\\b([_[:alpha:]]\\w*)\\s*(:)",
    "push": [
     {
      "match": "(,)|(?=\\))",
      "pop": true,
      "captures": {
       1: "punctuation.separator.parameters.python"
      }
     },
     {
      "include": "r_expression"
     },
     {
      "match": "=(?!=)",
      "scope": "keyword.operator.assignment.python"
     }
    ],
    "captures": {
     1: "variable.parameter.function.language.python",
     2: "punctuation.separator.annotation.python"
    }
   }
  ],
  "r_assignment_operator": [
   {
    "match": "<<=|>>=|//=|\\*\\*=|\\+=|-=|/=|@=|\\*=|%=|~=|\\^=|&=|\\|=|=(?!=)",
    "scope": "keyword.operator.assignment.python"
   }
  ],
  "r_backticks": [
   {
    "match": "`",
    "push": [
     {
      "meta_scope": "invalid.deprecated.backtick.python"
     },
     {
      "match": "`|(?<!\\\\)(\\n)",
      "pop": true
     },
     {
      "include": "r_expression"
     }
    ]
   }
  ],
  "r_builtin_callables": [
   {
    "include": "r_illegal_names"
   },
   {
    "include": "r_illegal_object_name"
   },
   {
    "include": "r_builtin_exceptions"
   },
   {
    "include": "r_builtin_functions"
   },
   {
    "include": "r_builtin_types"
   }
  ],
  "r_builtin_exceptions": [
   {
    "match": "(?<!\\.)\\b((Arithmetic|Assertion|Attribute|Buffer|BlockingIO|BrokenPipe|ChildProcess|(Connection(Aborted|Refused|Reset)?)|EOF|Environment|FileExists|FileNotFound|FloatingPoint|IO|Import|Indentation|Index|Interrupted|IsADirectory|NotADirectory|Permission|ProcessLookup|Timeout|Key|Lookup|Memory|Name|NotImplemented|OS|Overflow|Reference|Runtime|Recursion|Syntax|System|Tab|Type|UnboundLocal|Unicode(Encode|Decode|Translate)?|Value|Windows|ZeroDivision|ModuleNotFound)Error|((Pending)?Deprecation|Runtime|Syntax|User|Future|Import|Unicode|Bytes|Resource)?Warning|SystemExit|Stop(Async)?Iteration|KeyboardInterrupt|GeneratorExit|(Base)?Exception)\\b",
    "scope": "support.type.exception.python"
   }
  ],
  "r_builtin_functions": [
   {
    "match": "(?<!\\.)\\b(__import__|abs|aiter|all|any|anext|ascii|bin|breakpoint|callable|chr|compile|copyright|credits|delattr|dir|divmod|enumerate|eval|exec|exit|filter|format|getattr|globals|hasattr|hash|help|hex|id|input|isinstance|issubclass|iter|len|license|locals|map|max|memoryview|min|next|oct|open|ord|pow|print|quit|range|reload|repr|reversed|round|setattr|sorted|sum|vars|zip)\\b",
    "scope": "support.function.builtin.python"
   },
   {
    "match": "(?<!\\.)\\b(file|reduce|intern|raw_input|unicode|cmp|basestring|execfile|long|xrange)\\b",
    "scope": "variable.legacy.builtin.python"
   }
  ],
  "r_builtin_possible_callables": [
   {
    "include": "r_builtin_callables"
   },
   {
    "include": "r_magic_names"
   }
  ],
  "r_builtin_types": [
   {
    "match": "(?<!\\.)\\b(bool|bytearray|bytes|classmethod|complex|dict|float|frozenset|int|list|object|property|set|slice|staticmethod|str|tuple|type|super)\\b",
    "scope": "support.type.python"
   }
  ],
  "r_call_wrapper_inheritance": [
   {
    "match": "\\b(?=([_[:alpha:]]\\w*)\\s*(\\())",
    "push": [
     {
      "meta_scope": "meta.function-call.python"
     },
     {
      "match": "(\\))",
      "pop": true,
      "captures": {
       1: "punctuation.definition.arguments.end.python"
      }
     },
     {
      "include": "r_inheritance_name"
     },
     {
      "include": "r_function_arguments"
     }
    ]
   }
  ],
  "r_class_declaration": [
   {
    "match": "\\s*(class)\\s+(?=[_[:alpha:]]\\w*\\s*([(:]))",
    "push": [
     {
      "meta_scope": "meta.class.python"
     },
     {
      "match": "(:)",
      "pop": true,
      "captures": {
       1: "punctuation.section.class.begin.python"
      }
     },
     {
      "include": "r_class_name"
     },
     {
      "include": "r_class_inheritance"
     }
    ],
    "captures": {
     1: "storage.type.class.python"
    }
   }
  ],
  "r_class_inheritance": [
   {
    "match": "(\\()",
    "push": [
     {
      "meta_scope": "meta.class.inheritance.python"
     },
     {
      "match": "(\\))",
      "pop": true,
      "captures": {
       1: "punctuation.definition.inheritance.end.python"
      }
     },
     {
      "match": "(\\*\\*?)",
      "scope": "keyword.operator.unpacking.arguments.python"
     },
     {
      "match": ",",
      "scope": "punctuation.separator.inheritance.python"
     },
     {
      "match": "=(?!=)",
      "scope": "keyword.operator.assignment.python"
     },
     {
      "match": "\\bmetaclass\\b",
      "scope": "support.type.metaclass.python"
     },
     {
      "include": "r_illegal_names"
     },
     {
      "include": "r_class_kwarg"
     },
     {
      "include": "r_call_wrapper_inheritance"
     },
     {
      "include": "r_expression_base"
     },
     {
      "include": "r_member_access_class"
     },
     {
      "include": "r_inheritance_identifier"
     }
    ],
    "captures": {
     1: "punctuation.definition.inheritance.begin.python"
    }
   }
  ],
  "r_class_kwarg": [
   {
    "match": "\\b([_[:alpha:]]\\w*)\\s*(=)(?!=)",
    "captures": {
     1: "entity.other.inherited-class.python variable.parameter.class.python",
     2: "keyword.operator.assignment.python"
    }
   }
  ],
  "r_class_name": [
   {
    "include": "r_illegal_object_name"
   },
   {
    "include": "r_builtin_possible_callables"
   },
   {
    "match": "\\b([_[:alpha:]]\\w*)\\b",
    "scope": "entity.name.type.class.python"
   }
  ],
  "r_codetags": [
   {
    "match": "\\b(NOTE|XXX|HACK|FIXME|BUG|TODO)\\b",
    "captures": {
     1: "keyword.codetag.notation.python"
    }
   }
  ],
  "r_comments": [
   {
    "match": "#\\s*(type:)\\s*+(?!$|#)",
    "push": [
     {
      "meta_scope": "comment.line.number-sign.python"
     },
     {
      "meta_content_scope": "meta.typehint.comment.python"
     },
     {
      "match": "$|(?=#)",
      "pop": true
     },
     {
      "match": "\\Gignore(?=\\s*(?:$|#))",
      "scope": "comment.typehint.ignore.notation.python"
     },
     {
      "match": "(?<!\\.)\\b(bool|bytes|float|int|object|str|List|Dict|Iterable|Sequence|Set|FrozenSet|Callable|Union|Tuple|Any|None)\\b",
      "scope": "comment.typehint.type.notation.python"
     },
     {
      "match": "([]()*,.=\\[]|(->))",
      "scope": "comment.typehint.punctuation.notation.python"
     },
     {
      "match": "([_[:alpha:]]\\w*)",
      "scope": "comment.typehint.variable.notation.python"
     }
    ],
    "scope": "meta.typehint.comment.python",
    "captures": {
     1: "comment.typehint.directive.notation.python"
    }
   },
   {
    "include": "r_comments_base"
   }
  ],
  "r_comments_base": [
   {
    "match": "(#)",
    "push": [
     {
      "meta_scope": "comment.line.number-sign.python"
     },
     {
      "match": "$()",
      "pop": true
     },
     {
      "include": "r_codetags"
     }
    ],
    "captures": {
     1: "punctuation.definition.comment.python"
    }
   }
  ],
  "r_comments_string_double_three": [
   {
    "match": "(#)",
    "push": [
     {
      "meta_scope": "comment.line.number-sign.python"
     },
     {
      "match": "($|(?=\"\"\"))",
      "pop": true
     },
     {
      "include": "r_codetags"
     }
    ],
    "captures": {
     1: "punctuation.definition.comment.python"
    }
   }
  ],
  "r_comments_string_single_three": [
   {
    "match": "(#)",
    "push": [
     {
      "meta_scope": "comment.line.number-sign.python"
     },
     {
      "match": "($|(?='''))",
      "pop": true
     },
     {
      "include": "r_codetags"
     }
    ],
    "captures": {
     1: "punctuation.definition.comment.python"
    }
   }
  ],
  "r_curly_braces": [
   {
    "match": "\\{",
    "push": [
     {
      "match": "}",
      "pop": true,
      "scope": "punctuation.definition.dict.end.python"
     },
     {
      "match": ":",
      "scope": "punctuation.separator.dict.python"
     },
     {
      "include": "r_expression"
     }
    ],
    "scope": "punctuation.definition.dict.begin.python"
   }
  ],
  "r_decorator": [
   {
    "match": "^\\s*((@))\\s*(?=[_[:alpha:]]\\w*)",
    "push": [
     {
      "meta_scope": "meta.function.decorator.python"
     },
     {
      "match": "(\\))(.*?)(?=\\s*(?:#|$))|(?=[\\n#])",
      "pop": true,
      "captures": {
       1: "punctuation.definition.arguments.end.python",
       2: "invalid.illegal.decorator.python"
      }
     },
     {
      "include": "r_decorator_name"
     },
     {
      "include": "r_function_arguments"
     }
    ],
    "captures": {
     1: "entity.name.function.decorator.python",
     2: "punctuation.definition.decorator.python"
    }
   }
  ],
  "r_decorator_name": [
   {
    "include": "r_builtin_callables"
   },
   {
    "include": "r_illegal_object_name"
   },
   {
    "match": "([_[:alpha:]]\\w*)|(\\.)",
    "scope": "entity.name.function.decorator.python",
    "captures": {
     2: "punctuation.separator.period.python"
    }
   },
   {
    "include": "r_line_continuation"
   },
   {
    "match": "\\s*([^#(.\\\\_[:alpha:]\\s].*?)(?=#|$)",
    "scope": "invalid.illegal.decorator.python",
    "captures": {
     1: "invalid.illegal.decorator.python"
    }
   }
  ],
  "r_docstring": [
   {
    "match": "('''|\"\"\")",
    "push": [
     {
      "meta_scope": "string.quoted.docstring.multi.python"
     },
     {
      "match": "(\\1)",
      "pop": true,
      "captures": {
       1: "punctuation.definition.string.end.python"
      }
     },
     {
      "include": "r_docstring_prompt"
     },
     {
      "include": "r_codetags"
     },
     {
      "include": "r_docstring_guts_unicode"
     }
    ],
    "captures": {
     1: "punctuation.definition.string.begin.python"
    }
   },
   {
    "match": "([Rr])('''|\"\"\")",
    "push": [
     {
      "meta_scope": "string.quoted.docstring.raw.multi.python"
     },
     {
      "match": "(\\2)",
      "pop": true,
      "captures": {
       1: "punctuation.definition.string.end.python"
      }
     },
     {
      "include": "r_string_consume_escape"
     },
     {
      "include": "r_docstring_prompt"
     },
     {
      "include": "r_codetags"
     }
    ],
    "captures": {
     1: "storage.type.string.python",
     2: "punctuation.definition.string.begin.python"
    }
   },
   {
    "match": "([\"'])",
    "push": [
     {
      "meta_scope": "string.quoted.docstring.single.python"
     },
     {
      "match": "(\\1)|(\\n)",
      "pop": true,
      "captures": {
       1: "punctuation.definition.string.end.python",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_codetags"
     },
     {
      "include": "r_docstring_guts_unicode"
     }
    ],
    "captures": {
     1: "punctuation.definition.string.begin.python"
    }
   },
   {
    "match": "([Rr])([\"'])",
    "push": [
     {
      "meta_scope": "string.quoted.docstring.raw.single.python"
     },
     {
      "match": "(\\2)|(\\n)",
      "pop": true,
      "captures": {
       1: "punctuation.definition.string.end.python",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_string_consume_escape"
     },
     {
      "include": "r_codetags"
     }
    ],
    "captures": {
     1: "storage.type.string.python",
     2: "punctuation.definition.string.begin.python"
    }
   }
  ],
  "r_docstring_guts_unicode": [
   {
    "include": "r_escape_sequence_unicode"
   },
   {
    "include": "r_escape_sequence"
   },
   {
    "include": "r_string_line_continuation"
   }
  ],
  "r_docstring_prompt": [
   {
    "match": "(?:^|\\G)\\s*((?:>>>|\\.\\.\\.)\\s)(?=\\s*\\S)",
    "captures": {
     1: "keyword.control.flow.python"
    }
   }
  ],
  "r_docstring_statement": [
   {
    "match": "^(?=\\s*[Rr]?('''|\"\"\"|[\"']))",
    "push": [
     {
      "match": "((?<=\\1)|^)(?!\\s*[Rr]?('''|\"\"\"|[\"']))",
      "pop": true
     },
     {
      "include": "r_docstring"
     }
    ]
   }
  ],
  "r_double_one_regexp_character_set": [
   {
    "match": "\\[\\^?](?!.*?])"
   },
   {
    "match": "(\\[)(\\^)?(])?",
    "push": [
     {
      "meta_scope": "meta.character.set.regexp"
     },
     {
      "match": "(]|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "punctuation.character.set.end.regexp constant.other.set.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_regexp_charecter_set_escapes"
     },
     {
      "match": "\\N",
      "scope": "constant.character.set.regexp"
     }
    ],
    "captures": {
     1: "punctuation.character.set.begin.regexp constant.other.set.regexp",
     2: "keyword.operator.negation.regexp",
     3: "constant.character.set.regexp"
    }
   }
  ],
  "r_double_one_regexp_comments": [
   {
    "match": "\\(\\?#",
    "push": [
     {
      "meta_scope": "comment.regexp"
     },
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "punctuation.comment.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_codetags"
     }
    ],
    "scope": "punctuation.comment.begin.regexp"
   }
  ],
  "r_double_one_regexp_conditional": [
   {
    "match": "(\\()\\?\\((\\w+(?:\\s+\\p{alnum}+)?|\\d+)\\)",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "keyword.operator.conditional.negative.regexp punctuation.parenthesis.conditional.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "keyword.operator.conditional.regexp",
    "captures": {
     1: "punctuation.parenthesis.conditional.begin.regexp"
    }
   }
  ],
  "r_double_one_regexp_expression": [
   {
    "include": "r_regexp_base_expression"
   },
   {
    "include": "r_double_one_regexp_character_set"
   },
   {
    "include": "r_double_one_regexp_comments"
   },
   {
    "include": "r_regexp_flags"
   },
   {
    "include": "r_double_one_regexp_named_group"
   },
   {
    "include": "r_regexp_backreference"
   },
   {
    "include": "r_double_one_regexp_lookahead"
   },
   {
    "include": "r_double_one_regexp_lookahead_negative"
   },
   {
    "include": "r_double_one_regexp_lookbehind"
   },
   {
    "include": "r_double_one_regexp_lookbehind_negative"
   },
   {
    "include": "r_double_one_regexp_conditional"
   },
   {
    "include": "r_double_one_regexp_parentheses_non_capturing"
   },
   {
    "include": "r_double_one_regexp_parentheses"
   }
  ],
  "r_double_one_regexp_lookahead": [
   {
    "match": "(\\()\\?=",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "keyword.operator.lookahead.regexp punctuation.parenthesis.lookahead.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "keyword.operator.lookahead.regexp",
    "captures": {
     1: "punctuation.parenthesis.lookahead.begin.regexp"
    }
   }
  ],
  "r_double_one_regexp_lookahead_negative": [
   {
    "match": "(\\()\\?!",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "keyword.operator.lookahead.negative.regexp punctuation.parenthesis.lookahead.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "keyword.operator.lookahead.negative.regexp",
    "captures": {
     1: "punctuation.parenthesis.lookahead.begin.regexp"
    }
   }
  ],
  "r_double_one_regexp_lookbehind": [
   {
    "match": "(\\()\\?<=",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "keyword.operator.lookbehind.regexp punctuation.parenthesis.lookbehind.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "keyword.operator.lookbehind.regexp",
    "captures": {
     1: "punctuation.parenthesis.lookbehind.begin.regexp"
    }
   }
  ],
  "r_double_one_regexp_lookbehind_negative": [
   {
    "match": "(\\()\\?<!",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "keyword.operator.lookbehind.negative.regexp punctuation.parenthesis.lookbehind.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "keyword.operator.lookbehind.negative.regexp",
    "captures": {
     1: "punctuation.parenthesis.lookbehind.begin.regexp"
    }
   }
  ],
  "r_double_one_regexp_named_group": [
   {
    "match": "(\\()(\\?P<\\w+(?:\\s+\\p{alnum}+)?>)",
    "push": [
     {
      "meta_scope": "meta.named.regexp"
     },
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "support.other.parenthesis.regexp punctuation.parenthesis.named.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "captures": {
     1: "support.other.parenthesis.regexp punctuation.parenthesis.named.begin.regexp",
     2: "entity.name.tag.named.group.regexp"
    }
   }
  ],
  "r_double_one_regexp_parentheses": [
   {
    "match": "\\(",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "support.other.parenthesis.regexp punctuation.parenthesis.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "support.other.parenthesis.regexp punctuation.parenthesis.begin.regexp"
   }
  ],
  "r_double_one_regexp_parentheses_non_capturing": [
   {
    "match": "\\(\\?:",
    "push": [
     {
      "match": "(\\)|(?=\"))|((?=(?<!\\\\)\\n))",
      "pop": true,
      "captures": {
       1: "support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.end.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_double_one_regexp_expression"
     }
    ],
    "scope": "support.other.parenthesis.regexp punctuation.parenthesis.non-capturing.begin.regexp"
   }
  ],
  "r_double_three_regexp_character_set": [
   {
    "match": "\\[\\^?](?!.*?])"
   },
   {
    "match": "(\\[)(\\^)?(])?",
    "push": [
     {
      "meta_scope": "meta.character.set.regexp"
     },
     {
      "match": "(]|(?=\"\"\"))",
      "pop": true,
      "captures": {
       1: "punctuation.character.set.end.regexp constant.other.set.regexp",
       2: "invalid.illegal.newline.python"
      }
     },
     {
      "include": "r_regexp_charecter_set_escapes"
     },
