%YAML 1.2
---
{
 "name": "shiki-css",
 "scope": "source.css",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "include": "r_comment_block"
   },
   {
    "include": "r_escapes"
   },
   {
    "include": "r_combinator_invalid"
   },
   {
    "include": "r_selector"
   },
   {
    "include": "r_at_rules"
   },
   {
    "include": "r_rule_list"
   }
  ],
  "r_arithmetic_operators": [
   {
    "match": "[*/]|(?<=\\s|^)[-+](?=\\s|$)",
    "scope": "keyword.operator.arithmetic.css"
   }
  ],
  "r_at_rules": [
   {
    "match": "\\A\\uFEFF?(?i:(?=\\s*@charset\\b))",
    "push": [
     {
      "meta_scope": "meta.at-rule.charset.css"
     },
     {
      "match": ";|(?=$)",
      "pop": true,
      "scope": "punctuation.terminator.rule.css"
     },
     {
      "match": "\\G((?!@charset)@\\w+)|\\G(\\s+)|(@charset\\S[^;]*)|(?<=@charset)( {2,}|\\t+)|(?<=@charset )([^\";]+)|(\"[^\"]+)$|(?<=\")([^;]+)",
      "captures": {
       1: "invalid.illegal.not-lowercase.charset.css",
       2: "invalid.illegal.leading-whitespace.charset.css",
       3: "invalid.illegal.no-whitespace.charset.css",
       4: "invalid.illegal.whitespace.charset.css",
       5: "invalid.illegal.not-double-quoted.charset.css",
       6: "invalid.illegal.unclosed-string.charset.css",
       7: "invalid.illegal.unexpected-characters.charset.css"
      }
     },
     {
      "match": "((@)charset)(?=\\s)",
      "captures": {
       1: "keyword.control.at-rule.charset.css",
       2: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\"",
      "push": [
       {
        "meta_scope": "string.quoted.double.css"
       },
       {
        "match": "\"|$",
        "pop": true,
        "scope": "punctuation.definition.string.end.css"
       },
       {
        "match": "(?:\\G|^)(?=[^\"]+$)",
        "push": [
         {
          "meta_scope": "invalid.illegal.unclosed.string.css"
         },
         {
          "match": "$",
          "pop": true
         }
        ]
       }
      ],
      "scope": "punctuation.definition.string.begin.css"
     }
    ]
   },
   {
    "match": "(?i)((@)import)(?:\\s+|$|(?=[\"']|/\\*))",
    "push": [
     {
      "meta_scope": "meta.at-rule.import.css"
     },
     {
      "match": ";",
      "pop": true,
      "scope": "punctuation.terminator.rule.css"
     },
     {
      "match": "\\G\\s*(?=/\\*)",
      "push": [
       {
        "match": "(?<=\\*/)\\s*",
        "pop": true
       },
       {
        "include": "r_comment_block"
       }
      ]
     },
     {
      "include": "r_string"
     },
     {
      "include": "r_url"
     },
     {
      "match": "\\s+"
     },
     {
      "include": "r_layer_import"
     },
     {
      "include": "r_media_query_list"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.import.css",
     2: "punctuation.definition.keyword.css"
    }
   },
   {
    "match": "(?i)((@)font-face)(?=\\s*|\\{|/\\*|$)",
    "push": [
     {
      "meta_scope": "meta.at-rule.font-face.css"
     },
     {
      "match": "(?!\\G)",
      "pop": true
     },
     {
      "include": "r_comment_block"
     },
     {
      "include": "r_escapes"
     },
     {
      "include": "r_rule_list"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.font-face.css",
     2: "punctuation.definition.keyword.css"
    }
   },
   {
    "match": "(?i)(@)page(?=[:{\\s]|/\\*|$)",
    "push": [
     {
      "meta_scope": "meta.at-rule.page.css"
     },
     {
      "match": "(?=\\s*($|[:;{]))",
      "pop": true,
      "scope": "keyword.control.at-rule.page.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "include": "r_rule_list"
     }
    ],
    "scope": "keyword.control.at-rule.page.css",
    "captures": {
     1: "punctuation.definition.keyword.css"
    }
   },
   {
    "match": "(?i)(?=@media([(\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)media",
      "push": [
       {
        "meta_scope": "meta.at-rule.media.header.css"
       },
       {
        "match": "(?=\\s*[;{])",
        "pop": true
       },
       {
        "include": "r_media_query_list"
       }
      ],
      "scope": "keyword.control.at-rule.media.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.media.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.media.end.bracket.curly.css"
       },
       {
        "include": "r_rule_list_innards"
       },
       {
        "include": "main"
       }
      ],
      "scope": "punctuation.section.media.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)(?=@counter-style([\"';{\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)counter-style",
      "push": [
       {
        "meta_scope": "meta.at-rule.counter-style.header.css"
       },
       {
        "match": "(?=\\s*\\{)",
        "pop": true
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       },
       {
        "match": "[-A-Z_a-z[^\\x00-\\x7F]](?:[-0-9A-Z_a-z[^\\x00-\\x7F]]|\\\\(?:\\h{1,6}|.))*",
        "scope": "variable.parameter.style-name.css"
       }
      ],
      "scope": "keyword.control.at-rule.counter-style.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.counter-style.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.property-list.end.bracket.curly.css"
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       },
       {
        "include": "r_rule_list_innards"
       }
      ],
      "scope": "punctuation.section.property-list.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)(?=@document([\"';{\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)document",
      "push": [
       {
        "meta_scope": "meta.at-rule.document.header.css"
       },
       {
        "match": "(?=\\s*[;{])",
        "pop": true
       },
       {
        "match": "(?i)(?<![-\\w])(url-prefix|domain|regexp)(\\()",
        "push": [
         {
          "meta_scope": "meta.function.document-rule.css"
         },
         {
          "match": "\\)",
          "pop": true,
          "scope": "punctuation.section.function.end.bracket.round.css"
         },
         {
          "include": "r_string"
         },
         {
          "include": "r_comment_block"
         },
         {
          "include": "r_escapes"
         },
         {
          "match": "[^\"')\\s]+",
          "scope": "variable.parameter.document-rule.css"
         }
        ],
        "captures": {
         1: "support.function.document-rule.css",
         2: "punctuation.section.function.begin.bracket.round.css"
        }
       },
       {
        "include": "r_url"
       },
       {
        "include": "r_commas"
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       }
      ],
      "scope": "keyword.control.at-rule.document.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.document.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.document.end.bracket.curly.css"
       },
       {
        "include": "main"
       }
      ],
      "scope": "punctuation.section.document.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)(?=@(?:-(?:webkit|moz|o|ms)-)?keyframes([\"';{\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)(?:-(?:webkit|moz|o|ms)-)?keyframes",
      "push": [
       {
        "meta_scope": "meta.at-rule.keyframes.header.css"
       },
       {
        "match": "(?=\\s*\\{)",
        "pop": true
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       },
       {
        "match": "[-A-Z_a-z[^\\x00-\\x7F]](?:[-0-9A-Z_a-z[^\\x00-\\x7F]]|\\\\(?:\\h{1,6}|.))*",
        "scope": "variable.parameter.keyframe-list.css"
       }
      ],
      "scope": "keyword.control.at-rule.keyframes.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.keyframes.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.keyframes.end.bracket.curly.css"
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       },
       {
        "match": "(?i)(?<![-\\w])(from|to)(?![-\\w])|([-+]?(?:\\d+(?:\\.\\d+)?|\\.\\d+)%)",
        "captures": {
         1: "entity.other.keyframe-offset.css",
         2: "entity.other.keyframe-offset.percentage.css"
        }
       },
       {
        "include": "r_rule_list"
       }
      ],
      "scope": "punctuation.section.keyframes.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)(?=@supports([(\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)|(?=;)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)supports",
      "push": [
       {
        "meta_scope": "meta.at-rule.supports.header.css"
       },
       {
        "match": "(?=\\s*[;{])",
        "pop": true
       },
       {
        "include": "r_feature_query_operators"
       },
       {
        "include": "r_feature_query"
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       }
      ],
      "scope": "keyword.control.at-rule.supports.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.supports.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.supports.end.bracket.curly.css"
       },
       {
        "include": "main"
       }
      ],
      "scope": "punctuation.section.supports.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)(?=@layer(?:[;{\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)|;",
      "pop": true,
      "scope": "punctuation.terminator.rule.css"
     },
     {
      "match": "(?i)\\G(@)layer",
      "push": [
       {
        "meta_scope": "meta.at-rule.layer.header.css"
       },
       {
        "match": "(?=\\s*[;{])",
        "pop": true
       },
       {
        "include": "r_layer_name_list"
       },
       {
        "include": "r_comment_block"
       },
       {
        "include": "r_escapes"
       }
      ],
      "scope": "keyword.control.at-rule.layer.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.layer.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.layer.end.bracket.curly.css"
       },
       {
        "include": "main"
       }
      ],
      "scope": "punctuation.section.layer.begin.bracket.curly.css"
     }
    ]
   },
   {
    "match": "(?i)((@)(-(ms|o)-)?viewport)(?=[\"';{\\s]|/\\*|$)",
    "push": [
     {
      "meta_scope": "meta.at-rule.viewport.css"
     },
     {
      "match": "(?=\\s*[;@{])",
      "pop": true
     },
     {
      "include": "r_comment_block"
     },
     {
      "include": "r_escapes"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.viewport.css",
     2: "punctuation.definition.keyword.css"
    }
   },
   {
    "match": "(?i)((@)font-feature-values)(?=[\"';{\\s]|/\\*|$)\\s*",
    "push": [
     {
      "meta_scope": "meta.at-rule.font-features.css"
     },
     {
      "meta_content_scope": "variable.parameter.font-name.css"
     },
     {
      "match": "(?=\\s*[;@{])",
      "pop": true
     },
     {
      "include": "r_comment_block"
     },
     {
      "include": "r_escapes"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.font-feature-values.css",
     2: "punctuation.definition.keyword.css"
    }
   },
   {
    "include": "r_font_features"
   },
   {
    "match": "(?i)((@)namespace)(?=[\"';\\s]|/\\*|$)",
    "push": [
     {
      "meta_scope": "meta.at-rule.namespace.css"
     },
     {
      "match": ";|(?=[@{])",
      "pop": true,
      "scope": "punctuation.terminator.rule.css"
     },
     {
      "include": "r_url"
     },
     {
      "match": "(?i)(?:\\G|^|(?<=\\s))(?=(?<=\\s|^)[-A-Z_a-z[^\\x00-\\x7F]]|\\s*/\\*(?:[^*]|\\*[^/])*\\*/)(.*?)([-A-Z_a-z[^\\x00-\\x7F]](?:[-0-9A-Z_a-z[^\\x00-\\x7F]]|\\\\(?:\\h{1,6}|.))*)",
      "captures": {
       2: "entity.name.function.namespace-prefix.css"
      }
     },
     {
      "include": "r_comment_block"
     },
     {
      "include": "r_escapes"
     },
     {
      "include": "r_string"
     }
    ],
    "captures": {
     1: "keyword.control.at-rule.namespace.css",
     2: "punctuation.definition.keyword.css"
    }
   },
   {
    "match": "(?i)(?=@[-\\w]+[^;]+;s*$)",
    "push": [
     {
      "match": "(?<=;)(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)[-\\w]+",
      "push": [
       {
        "meta_scope": "meta.at-rule.header.css"
       },
       {
        "match": ";",
        "pop": true,
        "scope": "punctuation.terminator.rule.css"
       }
      ],
      "scope": "keyword.control.at-rule.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     }
    ]
   },
   {
    "match": "(?i)(?=@[-\\w]+([({\\s]|/\\*|$))",
    "push": [
     {
      "match": "(?<=})(?!\\G)",
      "pop": true
     },
     {
      "match": "(?i)\\G(@)[-\\w]+",
      "push": [
       {
        "meta_scope": "meta.at-rule.header.css"
       },
       {
        "match": "(?=\\s*[;{])",
        "pop": true
       }
      ],
      "scope": "keyword.control.at-rule.css",
      "captures": {
       1: "punctuation.definition.keyword.css"
      }
     },
     {
      "match": "\\{",
      "push": [
       {
        "meta_scope": "meta.at-rule.body.css"
       },
       {
        "match": "}",
        "pop": true,
        "scope": "punctuation.section.end.bracket.curly.css"
       },
       {
        "include": "r_rule_list_innards"
       },
       {
        "include": "main"
       }
      ],
      "scope": "punctuation.section.begin.bracket.curly.css"
     }
    ]
   }
  ],
  "r_color_keywords": [
   {
    "match": "(?i)(?<![-\\w])(aqua|black|blue|fuchsia|gray|green|lime|maroon|navy|olive|orange|purple|red|silver|teal|white|yellow)(?![-\\w])",
    "scope": "support.constant.color.w3c-standard-color-name.css"
   },
   {
    "match": "(?i)(?<![-\\w])(aliceblue|antiquewhite|aquamarine|azure|beige|bisque|blanchedalmond|blueviolet|brown|burlywood|cadetblue|chartreuse|chocolate|coral|cornflowerblue|cornsilk|crimson|cyan|darkblue|darkcyan|darkgoldenrod|darkgray|darkgreen|darkgrey|darkkhaki|darkmagenta|darkolivegreen|darkorange|darkorchid|darkred|darksalmon|darkseagreen|darkslateblue|darkslategray|darkslategrey|darkturquoise|darkviolet|deeppink|deepskyblue|dimgray|dimgrey|dodgerblue|firebrick|floralwhite|forestgreen|gainsboro|ghostwhite|gold|goldenrod|greenyellow|grey|honeydew|hotpink|indianred|indigo|ivory|khaki|lavender|lavenderblush|lawngreen|lemonchiffon|lightblue|lightcoral|lightcyan|lightgoldenrodyellow|lightgray|lightgreen|lightgrey|lightpink|lightsalmon|lightseagreen|lightskyblue|lightslategray|lightslategrey|lightsteelblue|lightyellow|limegreen|linen|magenta|mediumaquamarine|mediumblue|mediumorchid|mediumpurple|mediumseagreen|mediumslateblue|mediumspringgreen|mediumturquoise|mediumvioletred|midnightblue|mintcream|mistyrose|moccasin|navajowhite|oldlace|olivedrab|orangered|orchid|palegoldenrod|palegreen|paleturquoise|palevioletred|papayawhip|peachpuff|peru|pink|plum|powderblue|rebeccapurple|rosybrown|royalblue|saddlebrown|salmon|sandybrown|seagreen|seashell|sienna|skyblue|slateblue|slategray|slategrey|snow|springgreen|steelblue|tan|thistle|tomato|transparent|turquoise|violet|wheat|whitesmoke|yellowgreen)(?![-\\w])",
    "scope": "support.constant.color.w3c-extended-color-name.css"
   },
   {
    "match": "(?i)(?<![-\\w])currentColor(?![-\\w])",
    "scope": "support.constant.color.current.css"
   },
   {
    "match": "(?i)(?<![-\\w])(ActiveBorder|ActiveCaption|AppWorkspace|Background|ButtonFace|ButtonHighlight|ButtonShadow|ButtonText|CaptionText|GrayText|Highlight|HighlightText|InactiveBorder|InactiveCaption|InactiveCaptionText|InfoBackground|InfoText|Menu|MenuText|Scrollbar|ThreeDDarkShadow|ThreeDFace|ThreeDHighlight|ThreeDLightShadow|ThreeDShadow|Window|WindowFrame|WindowText)(?![-\\w])",
    "scope": "invalid.deprecated.color.system.css"
   }
  ],
  "r_combinator_invalid": [
   {
    "match": "/deep/|>>>",
    "scope": "invalid.deprecated.combinator.css"
   }
  ],
  "r_combinators": [
   {
    "include": "r_combinator_invalid"
   },
   {
    "match": ">>|[+>~]",
    "scope": "keyword.operator.combinator.css"
   }
  ],
  "r_commas": [
   {
    "match": ",",
    "scope": "punctuation.separator.list.comma.css"
   }
  ],
  "r_comment_block": [
   {
    "match": "/\\*",
    "push": [
     {
      "meta_scope": "comment.block.css"
     },
     {
      "match": "\\*/",
      "pop": true,
      "scope": "punctuation.definition.comment.end.css"
     }
    ],
    "scope": "punctuation.definition.comment.begin.css"
   }
  ],
  "r_escapes": [
   {
    "match": "\\\\\\h{1,6}",
    "scope": "constant.character.escape.codepoint.css"
   },
   {
    "match": "\\\\$\\s*",
    "push": [
     {
      "meta_scope": "constant.character.escape.newline.css"
     },
     {
      "match": "^(?<!\\G)",
      "pop": true
     }
    ]
   },
   {
    "match": "\\\\.",
    "scope": "constant.character.escape.css"
   }
  ],
  "r_feature_query": [
   {
    "match": "\\(",
    "push": [
     {
      "meta_scope": "meta.feature-query.css"
     },
     {
      "match": "\\)",
      "pop": true,
      "scope": "punctuation.definition.condition.end.bracket.round.css"
     },
     {
      "include": "r_feature_query_operators"
     },
     {
      "include": "r_feature_query"
     }
    ],
    "scope": "punctuation.definition.condition.begin.bracket.round.css"
   }
  ],
  "r_feature_query_operators": [
   {
    "match": "(?i)(?<=[()\\s]|^|\\*/)(and|not|or)(?=[()\\s]|/\\*|$)"
   },
   {
    "include": "r_rule_list_innards"
   }
  ],
  "r_font_features": [
   {
    "match": "(?i)((@)(annotation|character-variant|ornaments|styleset|stylistic|swash))(?=[\"';@{\\s]|/\\*|$)",
    "push": [
