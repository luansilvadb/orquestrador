  "r_blockquote": [
   {
    "match": "(^|\\G) {0,3}(>) ?",
    "push": [
     {
      "meta_scope": "markup.quote.markdown"
     },
     {
      "match": "^(?!(^|)\\s*(>) ?)",
      "pop": true
     },
     {
      "include": "r_block"
     }
    ],
    "captures": {
     2: "punctuation.definition.quote.begin.markdown"
    }
   }
  ],
  "r_bold": [
   {
    "match": "(?<open>(\\*\\*(?=\\w)|(?<!\\w)\\*\\*|(?<!\\w)\\b__))(?=\\S)(?=(<[^>]*+>|(?<raw>`+)([^`]|(?!(?<!`)\\k<raw>(?!`))`)*+\\k<raw>|\\\\[-\\]!#(-+.>\\[\\\\_`{}]?+|\\[((?<square>[^]\\[\\\\]|\\\\.|\\[\\g<square>*+])*+](( ?\\[[^]]*+])|(\\([\\t ]*+<?(.*?)>?[\\t ]*+((?<title>[\"'])(.*?)\\k<title>)?\\))))|(?!(?<=\\S)\\k<open>).)++(?<=\\S)(?=__\\b|\\*\\*)\\k<open>)",
    "push": [
     {
      "meta_scope": "markup.bold.markdown"
     },
     {
      "match": "(?<=\\S)(\\1)",
      "pop": true,
