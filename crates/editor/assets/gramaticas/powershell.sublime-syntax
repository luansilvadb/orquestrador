%YAML 1.2
---
{
 "name": "shiki-powershell",
 "scope": "source.powershell",
 "file_extensions": [],
 "hidden": true,
 "contexts": {
  "main": [
   {
    "match": "<#",
    "push": [
     {
      "meta_scope": "comment.block.powershell"
     },
     {
      "match": "#>",
      "pop": true,
      "scope": "punctuation.definition.comment.block.end.powershell"
     },
     {
      "include": "r_commentEmbeddedDocs"
     }
    ],
    "scope": "punctuation.definition.comment.block.begin.powershell"
   },
   {
    "match": "[2-6]>&1|>>?|<<|[<>]|>\\||[1-6]>|[1-6]>>",
    "scope": "keyword.operator.redirection.powershell"
   },
   {
    "include": "r_commands"
   },
   {
    "include": "r_commentLine"
   },
   {
    "include": "r_variable"
   },
   {
    "include": "r_subexpression"
   },
   {
    "include": "r_function"
   },
   {
    "include": "r_attribute"
   },
   {
    "include": "r_UsingDirective"
   },
   {
    "include": "r_type"
   },
   {
    "include": "r_hashtable"
   },
   {
    "include": "r_doubleQuotedString"
   },
   {
    "include": "r_scriptblock"
   },
   {
    "include": "r_doubleQuotedStringEscapes"
   },
   {
    "match": "['‘-‛]",
    "push": [
     {
      "meta_scope": "string.quoted.single.powershell"
     },
     {
      "match": "['‘-‛]{2}",
      "scope": "constant.character.escape.powershell"
     },
     {
      "match": "['‘-‛]",
      "pop": true,
      "scope": "punctuation.definition.string.end.powershell"
     }
    ],
    "scope": "punctuation.definition.string.begin.powershell"
   },
   {
    "match": "(@[\"“”„])\\s*$",
    "push": [
     {
      "meta_scope": "string.quoted.double.heredoc.powershell"
     },
     {
      "match": "^[\"“”„]@",
      "pop": true,
      "scope": "punctuation.definition.string.end.powershell"
     },
     {
      "include": "r_variableNoProperty"
     },
     {
      "include": "r_doubleQuotedStringEscapes"
     },
     {
      "include": "r_interpolation"
     }
    ],
    "captures": {
     1: "punctuation.definition.string.begin.powershell"
    }
   },
   {
    "match": "(@['‘-‛])\\s*$",
    "push": [
     {
      "meta_scope": "string.quoted.single.heredoc.powershell"
     },
     {
      "match": "^['‘-‛]@",
      "pop": true,
      "scope": "punctuation.definition.string.end.powershell"
     }
    ],
    "captures": {
     1: "punctuation.definition.string.begin.powershell"
    }
   },
   {
    "include": "r_numericConstant"
   },
   {
    "match": "(@)(\\()",
    "push": [
     {
      "meta_scope": "meta.group.array-expression.powershell"
     },
     {
      "match": "\\)",
      "pop": true,
      "scope": "punctuation.section.group.end.powershell"
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.other.array.begin.powershell",
     2: "punctuation.section.group.begin.powershell"
    }
   },
   {
    "match": "((\\$))(\\()",
    "push": [
     {
      "meta_scope": "meta.group.complex.subexpression.powershell"
     },
     {
      "match": "\\)",
      "pop": true,
      "scope": "punctuation.section.group.end.powershell"
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.other.substatement.powershell",
     2: "punctuation.definition.subexpression.powershell",
     3: "punctuation.section.group.begin.powershell"
    }
   },
   {
    "match": "\\b((([-.0-9A-Z_a-z]+)\\.(?i:exe|com|cmd|bat)))\\b",
    "scope": "support.function.powershell"
   },
   {
    "match": "(?<![-.\\w])((?i:begin|break|catch|clean|continue|data|default|define|do|dynamicparam|else|elseif|end|exit|finally|for|from|if|in|inlinescript|parallel|param|process|return|sequence|switch|throw|trap|try|until|var|while)|[%?])(?!\\w)",
    "scope": "keyword.control.powershell"
   },
   {
    "match": "(?<![-\\w]|[^)]\\.)((?i:(foreach|where)(?!-object))|[%?])(?!\\w)",
    "scope": "keyword.control.powershell"
   },
   {
    "match": "(?<!\\w)(--%)(?!\\w)",
    "push": [
     {
      "match": "$",
      "pop": true
     },
     {
      "match": ".+",
      "scope": "string.unquoted.powershell"
     }
    ],
    "captures": {
     1: "keyword.control.powershell"
    }
   },
   {
    "match": "(?<!\\w)((?i:hidden|static))(?!\\w)",
    "scope": "storage.modifier.powershell"
   },
   {
    "match": "(?<![-\\w])((?i:class)|[%?])\\s+([-_\\p{L}\\d]?{1,})\\b",
    "captures": {
     1: "storage.type.powershell",
     2: "entity.name.function"
    }
   },
   {
    "match": "(?<!\\w)-(?i:is(?:not)?|as)\\b",
    "scope": "keyword.operator.comparison.powershell"
   },
   {
    "match": "(?<!\\w)-(?i:[ci]?(?:eq|ne|[gl][et]|(?:not)?(?:like|match|contains|in)|replace))(?!\\p{L})",
    "scope": "keyword.operator.comparison.powershell"
   },
   {
    "match": "(?<!\\w)-(?i:join|split)(?!\\p{L})|!",
    "scope": "keyword.operator.unary.powershell"
   },
   {
    "match": "(?<!\\w)-(?i:and|or|not|xor)(?!\\p{L})|!",
    "scope": "keyword.operator.logical.powershell"
   },
   {
    "match": "(?<!\\w)-(?i:band|bor|bnot|bxor|shl|shr)(?!\\p{L})",
    "scope": "keyword.operator.bitwise.powershell"
   },
   {
    "match": "(?<!\\w)-(?i:f)(?!\\p{L})",
    "scope": "keyword.operator.string-format.powershell"
   },
   {
    "match": "[-%*+/]?=|[-%*+/]",
    "scope": "keyword.operator.assignment.powershell"
   },
   {
    "match": "\\|{2}|&{2}|;",
    "scope": "punctuation.terminator.statement.powershell"
   },
   {
    "match": "&|(?<!\\w)\\.(?= )|[,`|]",
    "scope": "keyword.operator.other.powershell"
   },
   {
    "match": "(?<!\\s|^)\\.\\.(?=-?\\d|[$(])",
    "scope": "keyword.operator.range.powershell"
   }
  ],
  "r_RequiresDirective": [
   {
    "match": "(?<=#)(?i:(requires))\\s",
    "push": [
     {
      "meta_scope": "meta.requires.powershell"
     },
     {
      "match": "$",
      "pop": true
     },
     {
      "match": "-(?i:Modules|PSSnapin|RunAsAdministrator|ShellId|Version|Assembly|PSEdition)",
      "scope": "keyword.other.powershell"
     },
     {
      "match": "(?<!-)\\b\\p{L}+|\\d+(?:\\.\\d+)*",
      "scope": "variable.parameter.powershell"
     },
     {
      "include": "r_hashtable"
     }
    ],
    "scope": "keyword.control.requires.powershell"
   }
  ],
  "r_UsingDirective": [
   {
    "match": "(?<!\\w)(?i:(using))\\s+(?i:(namespace|module))\\s+(?i:((?:\\w+\\.?)+))",
    "captures": {
     1: "keyword.control.using.powershell",
     2: "keyword.other.powershell",
     3: "variable.parameter.powershell"
    }
   }
  ],
  "r_attribute": [
   {
    "match": "(\\[)\\s*\\b(?i)(cmdletbinding|alias|outputtype|parameter|validatenotnull|validatenotnullorempty|validatecount|validateset|allownull|allowemptycollection|allowemptystring|validatescript|validaterange|validatepattern|validatelength|supportswildcards)\\b",
    "push": [
     {
      "meta_scope": "meta.attribute.powershell"
     },
     {
      "match": "(])",
      "pop": true,
      "captures": {
       1: "punctuation.section.bracket.end.powershell"
      }
     },
     {
      "match": "\\(",
      "push": [
       {
        "match": "\\)",
        "pop": true,
        "scope": "punctuation.section.group.end.powershell"
       },
       {
        "include": "main"
       },
       {
        "match": "(?i)\\b(mandatory|valuefrompipeline|valuefrompipelinebypropertyname|valuefromremainingarguments|position|parametersetname|defaultparametersetname|supportsshouldprocess|supportspaging|positionalbinding|helpuri|confirmimpact|helpmessage)\\b\\s+{0,1}(=)?",
        "captures": {
         1: "variable.parameter.attribute.powershell",
         2: "keyword.operator.assignment.powershell"
        }
       }
      ],
      "scope": "punctuation.section.group.begin.powershell"
     }
    ],
    "captures": {
     1: "punctuation.section.bracket.begin.powershell",
     2: "support.function.attribute.powershell"
    }
   }
  ],
  "r_commands": [
   {
    "match": "(?:([-:\\\\_\\p{L}\\d])*\\\\)?\\b(?i:Add|Approve|Assert|Backup|Block|Build|Checkpoint|Clear|Close|Compare|Complete|Compress|Confirm|Connect|Convert|ConvertFrom|ConvertTo|Copy|Debug|Deny|Deploy|Disable|Disconnect|Dismount|Edit|Enable|Enter|Exit|Expand|Export|Find|Format|Get|Grant|Group|Hide|Import|Initialize|Install|Invoke|Join|Limit|Lock|Measure|Merge|Mount|Move|New|Open|Optimize|Out|Ping|Pop|Protect|Publish|Push|Read|Receive|Redo|Register|Remove|Rename|Repair|Request|Reset|Resize|Resolve|Restart|Restore|Resume|Revoke|Save|Search|Select|Send|Set|Show|Skip|Split|Start|Step|Stop|Submit|Suspend|Switch|Sync|Test|Trace|Unblock|Undo|Uninstall|Unlock|Unprotect|Unpublish|Unregister|Update|Use|Wait|Watch|Write)-.+?(?:\\.(?i:exe|cmd|bat|ps1))?\\b",
    "scope": "support.function.powershell"
   },
   {
    "match": "(?<!\\w)(?i:foreach-object)(?!\\w)",
    "scope": "support.function.powershell"
   },
   {
    "match": "(?<!\\w)(?i:where-object)(?!\\w)",
    "scope": "support.function.powershell"
   },
   {
    "match": "(?<!\\w)(?i:sort-object)(?!\\w)",
    "scope": "support.function.powershell"
   },
   {
    "match": "(?<!\\w)(?i:tee-object)(?!\\w)",
    "scope": "support.function.powershell"
   }
  ],
  "r_commentEmbeddedDocs": [
   {
    "match": "(?:^|\\G)(?i:\\s*(\\.)(COMPONENT|DESCRIPTION|EXAMPLE|FUNCTIONALITY|INPUTS|LINK|NOTES|OUTPUTS|ROLE|SYNOPSIS))\\s*$",
    "scope": "comment.documentation.embedded.powershell",
    "captures": {
     1: "constant.string.documentation.powershell",
     2: "keyword.operator.documentation.powershell"
    }
   },
   {
    "match": "(?:^|\\G)(?i:\\s*(\\.)(EXTERNALHELP|FORWARDHELP(?:CATEGORY|TARGETNAME)|PARAMETER|REMOTEHELPRUNSPACE))\\s+(.+?)\\s*$",
    "scope": "comment.documentation.embedded.powershell",
    "captures": {
     1: "constant.string.documentation.powershell",
     2: "keyword.operator.documentation.powershell",
     3: "keyword.operator.documentation.powershell"
    }
   }
  ],
  "r_commentLine": [
   {
    "match": "(?<![-\\\\`])(#)#*",
    "push": [
     {
      "meta_scope": "comment.line.powershell"
     },
     {
      "match": "$\\n?",
      "pop": true,
      "captures": {
       1: "punctuation.definition.comment.powershell"
      }
     },
     {
      "include": "r_commentEmbeddedDocs"
     },
     {
      "include": "r_RequiresDirective"
     }
    ],
    "captures": {
     1: "punctuation.definition.comment.powershell"
    }
   }
  ],
  "r_doubleQuotedString": [
   {
    "match": "[\"“”„]",
    "push": [
     {
      "meta_scope": "string.quoted.double.powershell"
     },
     {
      "match": "(?i)\\b[-%+.0-9A-Z_]+@[-.0-9A-Z]+\\.[A-Z]{2,64}\\b"
     },
     {
      "include": "r_variableNoProperty"
     },
     {
      "include": "r_doubleQuotedStringEscapes"
     },
     {
      "match": "[\"“”„]{2}",
      "scope": "constant.character.escape.powershell"
     },
     {
      "include": "r_interpolation"
     },
     {
      "match": "`\\s*$",
      "scope": "keyword.other.powershell"
     },
     {
      "match": "[\"“”„]",
      "pop": true,
      "scope": "punctuation.definition.string.end.powershell"
     }
    ],
    "scope": "punctuation.definition.string.begin.powershell"
   }
  ],
  "r_doubleQuotedStringEscapes": [
   {
    "match": "`[\"$'0`abefnrtv‘-„]",
    "scope": "constant.character.escape.powershell"
   },
   {
    "include": "r_unicodeEscape"
   }
  ],
  "r_function": [
   {
    "match": "^\\s*+(?i)(function|filter|configuration|workflow)\\s+(?:(global|local|script|private):)?([-._\\p{L}\\d]+)",
    "push": [
     {
      "match": "(?=[({])",
      "pop": true
     },
     {
      "include": "r_commentLine"
     }
    ],
    "scope": "meta.function.powershell",
    "captures": {
     1: "storage.type.powershell",
     2: "storage.modifier.scope.powershell",
     3: "entity.name.function.powershell"
    }
   }
  ],
  "r_hashtable": [
   {
    "match": "(@)(\\{)",
    "push": [
     {
      "meta_scope": "meta.hashtable.powershell"
     },
     {
      "match": "(})",
      "pop": true,
      "captures": {
       1: "punctuation.section.braces.end.powershell"
      }
     },
     {
      "match": "\\b([\"']?)(\\w+)([\"']?)\\s+{0,1}(=)\\s+{0,1}",
      "scope": "meta.hashtable.assignment.powershell",
      "captures": {
       1: "punctuation.definition.string.begin.powershell",
       2: "variable.other.readwrite.powershell",
       3: "punctuation.definition.string.end.powershell",
       4: "keyword.operator.assignment.powershell"
      }
     },
     {
      "include": "r_scriptblock"
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.other.hashtable.begin.powershell",
     2: "punctuation.section.braces.begin.powershell"
    }
   }
  ],
  "r_interpolation": [
   {
    "match": "(((\\$)))((\\())",
    "push": [
     {
      "meta_scope": "meta.embedded.substatement.powershell"
     },
     {
      "meta_content_scope": "interpolated.complex.source.powershell"
     },
     {
      "match": "(\\))",
      "pop": true,
      "scope": "punctuation.section.group.end.powershell",
      "captures": {
       1: "punctuation.section.embedded.substatement.end.powershell"
      }
     },
     {
      "include": "main"
     }
    ],
    "captures": {
     1: "keyword.other.substatement.powershell",
     2: "punctuation.definition.substatement.powershell",
     3: "punctuation.section.embedded.substatement.begin.powershell",
     4: "punctuation.section.group.begin.powershell",
     5: "punctuation.section.embedded.substatement.begin.powershell"
    }
   }
  ],
  "r_numericConstant": [
   {
    "match": "(?<!\\w)([-+]?0[Xx][_\\h]+(?:[LUlu]|UL|Ul|uL|ul|LU|Lu|lU|lu)?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.hex.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?[0-9_]+{0,1}\\.[0-9_]+(?:[Ee][0-9]+)?[DFMdfm]?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.integer.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?0[Bb][01_]+(?:[LUlu]|UL|Ul|uL|ul|LU|Lu|lU|lu)?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.octal.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?[0-9_]+[Ee][0-9_]?+[DFMdfm]?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.integer.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?[0-9_]+\\.[Ee][0-9_]?+[DFMdfm]?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.integer.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?[0-9_]+\\.?[DFMdfm])((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.integer.powershell",
     2: "keyword.other.powershell"
    }
   },
   {
    "match": "(?<!\\w)([-+]?[0-9_]+\\.?(?:[LUlu]|UL|Ul|uL|ul|LU|Lu|lU|lu)?)((?i:[gkmpt]b)?)\\b",
    "captures": {
     1: "constant.numeric.integer.powershell",
     2: "keyword.other.powershell"
    }
   }
  ],
  "r_scriptblock": [
   {
    "match": "\\{",
    "push": [
     {
      "meta_scope": "meta.scriptblock.powershell"
     },
     {
      "match": "}",
      "pop": true,
      "scope": "punctuation.section.braces.end.powershell"
     },
     {
      "include": "main"
     }
    ],
    "scope": "punctuation.section.braces.begin.powershell"
   }
  ],
  "r_subexpression": [
   {
    "match": "\\(",
    "push": [
     {
      "meta_scope": "meta.group.simple.subexpression.powershell"
     },
     {
      "match": "\\)",
      "pop": true,
      "scope": "punctuation.section.group.end.powershell"
     },
     {
      "include": "main"
     }
    ],
    "scope": "punctuation.section.group.begin.powershell"
   }
  ],
  "r_type": [
   {
    "match": "\\[",
    "push": [
     {
      "match": "]",
      "pop": true,
      "scope": "punctuation.section.bracket.end.powershell"
     },
     {
      "match": "(?!\\d+|\\.)[.\\p{L}\\p{N}]+",
      "scope": "storage.type.powershell"
     },
     {
      "include": "main"
     }
    ],
    "scope": "punctuation.section.bracket.begin.powershell"
   }
  ],
  "r_unicodeEscape": [
   {
    "match": "`u\\{(?:(?:10)?(\\h){1,4}|0?\\g<1>{1,5})}",
    "scope": "constant.character.escape.powershell"
   },
   {
    "match": "`u(?:\\{\\h{0,6}.)?",
    "scope": "invalid.character.escape.powershell"
   }
  ],
  "r_variable": [
   {
    "match": "(\\$)(?i:(False|Null|True))\\b",
    "scope": "constant.language.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell"
    }
   },
   {
    "match": "(\\$)(?i:(Error|ExecutionContext|Host|Home|PID|PsHome|PsVersionTable|ShellID))((?:\\.[_\\p{L}\\d]+)*\\b)?\\b",
    "scope": "variable.other.constant.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     3: "variable.other.member.powershell"
    }
   },
   {
    "match": "(\\$)([$?^]|(?i:_|Args|ConsoleFileName|Event|EventArgs|EventSubscriber|ForEach|Input|LastExitCode|Matches|MyInvocation|NestedPromptLevel|Profile|PSBoundParameters|PsCmdlet|PsCulture|PSDebugContext|PSItem|PSCommandPath|PSScriptRoot|PsUICulture|Pwd|Sender|SourceArgs|SourceEventArgs|StackTrace|Switch|This)\\b)((?:\\.[_\\p{L}\\d]+)*\\b)?",
    "scope": "support.variable.automatic.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     3: "variable.other.member.powershell"
    }
   },
   {
    "match": "(\\$)(?i:(ConfirmPreference|DebugPreference|ErrorActionPreference|ErrorView|FormatEnumerationLimit|InformationPreference|LogCommandHealthEvent|LogCommandLifecycleEvent|LogEngineHealthEvent|LogEngineLifecycleEvent|LogProviderHealthEvent|LogProviderLifecycleEvent|MaximumAliasCount|MaximumDriveCount|MaximumErrorCount|MaximumFunctionCount|MaximumHistoryCount|MaximumVariableCount|OFS|OutputEncoding|PSCulture|PSDebugContext|PSDefaultParameterValues|PSEmailServer|PSItem|PSModuleAutoLoadingPreference|PSModuleAutoloadingPreference|PSSenderInfo|PSSessionApplicationName|PSSessionConfigurationName|PSSessionOption|ProgressPreference|VerbosePreference|WarningPreference|WhatIfPreference))((?:\\.[_\\p{L}\\d]+)*\\b)?\\b",
    "scope": "variable.language.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     3: "variable.other.member.powershell"
    }
   },
   {
    "match": "(?i:([$@])(global|local|private|script|using|workflow):([_\\p{L}\\d]+))((?:\\.[_\\p{L}\\d]+)*\\b)?",
    "scope": "variable.other.readwrite.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     2: "storage.modifier.scope.powershell",
     4: "variable.other.member.powershell"
    }
   },
   {
    "match": "(?i:(\\$)(\\{)(global|local|private|script|using|workflow):([^}]*[^`}])(}))((?:\\.[_\\p{L}\\d]+)*\\b)?",
    "scope": "variable.other.readwrite.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     2: "punctuation.section.braces.begin.powershell",
     3: "storage.modifier.scope.powershell",
     5: "punctuation.section.braces.end.powershell",
     6: "variable.other.member.powershell"
    }
   },
   {
    "match": "(?i:([$@])([_\\p{L}\\d]+:)?([_\\p{L}\\d]+))((?:\\.[_\\p{L}\\d]+)*\\b)?",
    "scope": "variable.other.readwrite.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
     2: "support.variable.drive.powershell",
     4: "variable.other.member.powershell"
    }
   },
   {
    "match": "(?i:(\\$)(\\{)([_\\p{L}\\d]+:)?([^}]*[^`}])(}))((?:\\.[_\\p{L}\\d]+)*\\b)?",
    "scope": "variable.other.readwrite.powershell",
    "captures": {
     1: "punctuation.definition.variable.powershell",
