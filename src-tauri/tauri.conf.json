{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orquestrador",
  "version": "0.1.9",
  "identifier": "dev.luansilvadb.orquestrador",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev:tauri",
    "beforeBuildCommand": "npm run build:tauri",
    "beforeBundleCommand": "npm run copy:delegar"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Orquestrador", "width": 1400, "height": 900, "center": true, "decorations": false }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "resources": { "target/delegar/": "" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/luansilvadb/orquestrador/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQkRCMUY4N0Q1NUIzNTUKUldSVnMxVjkrTEc5SzFhUU1pR004UE8yUVI3VTAwQnBLaHkrNVVVUDYyVGovZGNaT0cvTmVHSkgK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "quiet" }
    }
  }
}
