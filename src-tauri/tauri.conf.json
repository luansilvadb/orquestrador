{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orquestrador",
  "version": "0.1.0",
  "identifier": "dev.luansilvadb.orquestrador",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Orquestrador", "width": 1400, "height": 900 }],
    "security": { "csp": null }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.ico"] }
}
