{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orquestrador",
  "version": "0.1.40",
  "identifier": "dev.luansilvadb.orquestrador",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Orquestrador", "width": 1400, "height": 900, "center": true, "decorations": false, "visible": false, "backgroundColor": "#000000" }],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: http://orq-media.localhost",
        "connect-src": "ipc: http://ipc.localhost",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser", "installerHooks": "./windows/hooks.nsh" } }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/luansilvadb/orquestrador/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJCQkRCMUY4N0Q1NUIzNTUKUldSVnMxVjkrTEc5SzFhUU1pR004UE8yUVI3VTAwQnBLaHkrNVVVUDYyVGovZGNaT0cvTmVHSkgK",
      "requireSignedVersion": true,
      "allowDowngrades": false,
      "windows": { "installMode": "quiet" }
    }
  }
}
