{
  "name": "orquestrador",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:tauri": "cargo build --manifest-path src-tauri/Cargo.toml --bin orquestrador-delegar && vite",
    "build:tauri": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin orquestrador-delegar && npm run build",
    "copy:delegar": "node -e \"require('fs').copyFileSync('src-tauri/target/release/orquestrador-delegar.exe', 'src-tauri/target/delegar/orquestrador-delegar.exe')\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
