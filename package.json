{
  "name": "orquestrador",
  "private": true,
  "version": "0.1.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "dev:tauri": "cargo build --manifest-path src-tauri/Cargo.toml --bin orquestrador-delegar && vite",
    "build:tauri": "cargo build --release --manifest-path src-tauri/Cargo.toml --bin orquestrador-delegar && npm run build",
    "copy:delegar": "node -e \"require('fs').copyFileSync('src-tauri/target/release/orquestrador-delegar.exe', 'src-tauri/target/delegar/orquestrador-delegar.exe')\"",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@lobehub/fluent-emoji": "^4.1.1",
    "@lobehub/icons": "^5.23.0",
    "@lobehub/ui": "^5.58.0",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.6.6",
    "cn": "^0.4.0",
    "lucide-react": "^1.55.0",
    "motion": "^12.43.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
